/// Médiathèque — albums de photos (lecture publique des éléments publiés).
model media_albums {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug         String         @unique
  title        String
  description  String         @default("")
  cover        String         @default("")
  year         Int            @db.SmallInt
  is_published Boolean        @default(true)
  is_example   Boolean        @default(true)
  sort_order   Int            @default(0) @db.SmallInt
  created_at   DateTime       @default(now()) @db.Timestamptz(6)
  media_photos media_photos[]

  @@schema("public")
}

/// Médiathèque — photos (storage_path : bucket « media » ou URL publique).
model media_photos {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  album_id     String       @db.Uuid
  title        String       @default("")
  caption      String       @default("")
  storage_path String
  width        Int
  height       Int
  taken_at     DateTime?    @db.Timestamptz(6)
  featured     Boolean      @default(false)
  sort_order   Int          @default(0) @db.SmallInt
  is_published Boolean      @default(true)
  is_example   Boolean      @default(true)
  created_at   DateTime     @default(now()) @db.Timestamptz(6)
  media_albums media_albums @relation(fields: [album_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([album_id, sort_order], map: "media_photos_album_idx")
  @@schema("public")
}

/// Médiathèque — vidéos (source : fichier hébergé, YouTube ou Vimeo).
model media_videos {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug         String   @unique
  title        String
  description  String   @default("")
  source       String
  url          String
  poster       String   @default("")
  duration_sec Int      @default(0)
  category     String
  published_at DateTime @default(now()) @db.Timestamptz(6)
  featured     Boolean  @default(false)
  is_published Boolean  @default(true)
  is_example   Boolean  @default(true)
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  @@schema("public")
}

/// Événements publics (statut : brouillon | publie | annule).
model events {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug         String    @unique
  title        String
  description  String    @default("")
  type         String
  starts_at    DateTime  @db.Timestamptz(6)
  ends_at      DateTime? @db.Timestamptz(6)
  place        String    @default("")
  address      String    @default("")
  cover        String    @default("")
  register_url String?
  featured     Boolean   @default(false)
  status       String    @default("brouillon")
  is_example   Boolean   @default(true)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)

  @@index([starts_at], map: "events_starts_idx")
  @@schema("public")
}
