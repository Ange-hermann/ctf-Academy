# Modèle de variables d'environnement : copiez ce fichier en .env.local puis renseignez les valeurs.
# Sans Supabase, le site fonctionne en « mode démonstration » (données d'exemple, comptes simulés).

# URL publique du site (SEO, liens dans les e-mails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service : serveur uniquement, ne jamais l'exposer côté client
SUPABASE_SERVICE_ROLE_KEY=

# Prisma — connexion directe PostgreSQL (Supabase : Project Settings > Database,
# chaîne « Transaction pooler » ou « Session »). Sans elle : mode démonstration.
DATABASE_URL=

# Paiement : mock | cinetpay | paydunya | fedapay
PAYMENT_PROVIDER=mock
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
FEDAPAY_SECRET_KEY=

# E-mail : mock | resend
EMAIL_PROVIDER=mock
RESEND_API_KEY=
EMAIL_FROM="CTF ACADEMY <no-reply@example.org>"

# WhatsApp : numéro d'assistance (format international sans +, ex. 22500000000)
NEXT_PUBLIC_WHATSAPP_NUMBER=
# WhatsApp Business API (optionnel) : mock | business
WHATSAPP_PROVIDER=mock
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
